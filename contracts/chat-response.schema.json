{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ActionCard": {
      "properties": {
        "matter_name": {
          "title": "Matter Name",
          "type": "string"
        },
        "target_users": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Users",
          "type": "array"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/Material"
          },
          "minItems": 1,
          "title": "Materials",
          "type": "array"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "office_hours": {
          "title": "Office Hours",
          "type": "string"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline"
        },
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "contact": {
          "title": "Contact",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "matter_name",
        "target_users",
        "materials",
        "location",
        "office_hours",
        "channel",
        "contact",
        "sources",
        "confidence"
      ],
      "title": "ActionCard",
      "type": "object"
    },
    "EvidenceClaim": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "text",
        "references"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "minLength": 1,
          "title": "Item",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "item",
        "required"
      ],
      "title": "Material",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "issuer": {
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "doc_id": {
          "minLength": 1,
          "title": "Doc Id",
          "type": "string"
        },
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "title",
        "issuer",
        "date",
        "doc_id",
        "chunk_id"
      ],
      "title": "Source",
      "type": "object"
    },
    "SummaryPoint": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "maxLength": 30,
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "support": {
          "items": {
            "$ref": "#/$defs/SupportQuote"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Support",
          "type": "array"
        }
      },
      "required": [
        "heading",
        "text",
        "support"
      ],
      "title": "SummaryPoint",
      "type": "object"
    },
    "SupportQuote": {
      "additionalProperties": false,
      "properties": {
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "quote"
      ],
      "title": "SupportQuote",
      "type": "object"
    },
    "WebSource": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "content_kind": {
          "default": "snippet",
          "enum": [
            "snippet",
            "page"
          ],
          "title": "Content Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "snippet",
        "retrieved_at"
      ],
      "title": "WebSource",
      "type": "object"
    }
  },
  "properties": {
    "status": {
      "default": "refusal",
      "enum": [
        "refusal",
        "card",
        "clarification"
      ],
      "title": "Status",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "card": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActionCard"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "ai_generated": {
      "default": true,
      "title": "Ai Generated",
      "type": "boolean"
    },
    "ai_status": {
      "default": "disabled",
      "enum": [
        "disabled",
        "used",
        "unavailable"
      ],
      "title": "Ai Status",
      "type": "string"
    },
    "ai_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ai Model"
    },
    "demo_mode": {
      "default": false,
      "title": "Demo Mode",
      "type": "boolean"
    },
    "web_sources": {
      "items": {
        "$ref": "#/$defs/WebSource"
      },
      "title": "Web Sources",
      "type": "array"
    },
    "analysis": {
      "items": {
        "$ref": "#/$defs/EvidenceClaim"
      },
      "title": "Analysis",
      "type": "array"
    },
    "summary_points": {
      "items": {
        "$ref": "#/$defs/SummaryPoint"
      },
      "title": "Summary Points",
      "type": "array"
    },
    "local_evidence": {
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      },
      "title": "Local Evidence",
      "type": "object"
    },
    "search_status": {
      "default": "disabled",
      "enum": [
        "disabled",
        "used",
        "empty",
        "unavailable"
      ],
      "title": "Search Status",
      "type": "string"
    },
    "school_id": {
      "default": "imuchuangye",
      "title": "School Id",
      "type": "string"
    }
  },
  "required": [
    "message"
  ],
  "title": "ChatResponse",
  "type": "object"
}
