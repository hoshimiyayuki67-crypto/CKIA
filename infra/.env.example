# Only needed for the optional HTTPS gateway. Example: api.example.com
CAMPUS_DOMAIN=
# Tag of locally built backend image; use the Git commit SHA for deployments.
CAMPUS_IMAGE_TAG=local
# For compose.tls.yaml with an existing public certificate.
CAMPUS_HTTPS_PORT=7010
# Mount the certificate tree, including targets of any symlinks.
CAMPUS_CERT_DIR=
# Optional registry alternatives when Docker Hub is unreachable.
CAMPUS_PYTHON_IMAGE=python:3.11-slim
CAMPUS_GATEWAY_IMAGE=caddy:2-alpine
